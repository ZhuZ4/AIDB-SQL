# Copy to .env only on a fresh deployment. bootstrap_database.py creates local credentials.
BIRD_DEV_PG_URI=postgresql+psycopg2://aidb_reader:REPLACE@127.0.0.1:55432/AIDB-vector
BIRD_DEV_ADMIN_URI=postgresql+psycopg2://aidb_owner:REPLACE@127.0.0.1:55432/AIDB-vector
BIRD_DEV_SCHEMA=bird_dev_emb_v2
BIRD_DEV_INDEX_LAYOUT=column_dual_v1
BIRD_DEV_COLUMN_TABLE=column_embeddings
# Full experiments require an immutable version from deploy/build-column-index.py.
BIRD_DEV_INDEX_VERSION=
# Business data comes only from the original SQLite files, opened read-only.
DATABASE_URI=sqlite:///file:F:/data/VSCodeproject/minidev/MINIDEV/dev_databases/california_schools/california_schools.sqlite?immutable=1&mode=ro&uri=true
# SQLite file name supplies db_id; leave the fallback unset.
BIRD_DEV_DB_ID=
MINIDEV_ROOT=F:/data/VSCodeproject/minidev/MINIDEV
DESCRIPTION_DIR=
EMBEDDING_API_URL=http://127.0.0.1:8080/v1
EMBEDDING_API_KEY=no-key
EMBEDDING_MODEL=jina-embeddings-v3-Q8_0.gguf
EMBEDDING_DIM=1024
# Enter the existing SQL generation API configuration; never commit its key.
LITE_LLM_BASE_URL=
LITE_LLM_API_KEY=
LITE_LLM_MODEL_NAME=deepseek-v4.1-flash
